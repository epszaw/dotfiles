{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "lsp": true,
  "mcp": {
    "shadcn": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "stripe": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.stripe.com"
    },
    "wallaby": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "-c",
        "node",
        "~/.wallaby/mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js"
  ]
}
